<script>
/* ── DATA ── */
const TASKS = [
  {n:"Vacuum the house",       c:"A"},
  {n:"Mop the floors",         c:"A"},
  {n:"Wash all dishes",        c:"A"},
  {n:"Wipe kitchen counters",  c:"A"},
  {n:"Clothes in hamper",      c:"A"},
  {n:"Vacuum bathroom floors", c:"A"},
  {n:"Kitchen trash",          c:"A"},
  {n:"Wash the comforters",    c:"B"},
  {n:"Change flat sheets",     c:"B"},
  {n:"Clean the stove top",    c:"B"},
  {n:"Change kitchen towel",   c:"B"},
  {n:"Jackets on hangers",     c:"B"},
  {n:"Fold your clothes",      c:"B"},
  {n:"Desk trash removal",     c:"B"},
  {n:"Replenish bathroom rolls",c:"B"},
  {n:"Wipe kitchen + bathroom sink + mirror", c:"B"},
  {n:"Sanitize toilet seat",   c:"B"},
  {n:"Wipe desk",              c:"B"},
  {n:"Sweep with broom",       c:"C"},
  {n:"Change bathroom trash",  c:"C"},
  {n:"Wipe bathroom floors",   c:"C"},
  {n:"Wash bathroom mat",      c:"C"},
  {n:"Wipe other counters",    c:"C"},
  {n:"Finally buy flowers 🌸", c:"D"},
];

const FREQ = {A:"High frequency",B:"Regular",C:"Less frequent",D:"Rare treat"};
const DMAP = {1:"A",2:"A",3:"A",4:"A",5:"B",6:"B",7:"B",8:"C",9:"C",10:"D"};
const BC   = {A:"bA",B:"bB",C:"bC",D:"bD"};

/* ── STATE ── */
let state = {};
let rollIdx = null;

function load() {
  try { state = JSON.parse(localStorage.getItem('ct3') || '{}'); } catch(e) { state = {}; }
}
function save() {
  try { localStorage.setItem('ct3', JSON.stringify(state)); } catch(e) {}
}
load();

/* ── UTILS ── */
function ago(ts) {
  const s = (Date.now()-ts)/1000;
  if (s < 90)   return 'just now';
  if (s < 3600) return Math.round(s/60)+'m ago';
  if (s < 86400)return Math.round(s/3600)+'h ago';
  return Math.round(s/86400)+'d ago';
}

/* ── RENDER: STATS ── */
function renderStats() {
  document.getElementById('stats').innerHTML =
    ['A','B','C','D'].map(c => {
      const tot = TASKS.filter(t=>t.c===c).length;
      const dn  = TASKS.filter((t,i)=>t.c===c&&state[i]).length;
      return `<div class="stat">
        <div class="stat-letter">${c}</div>
        <div class="stat-count">${dn}/${tot}</div>
      </div>`;
    }).join('');
}

/* ── RENDER: ALL TASKS ── */
function renderAll() {
  document.getElementById('task-list').innerHTML =
    TASKS.map((t,i) => {
      const ts = state[i];
      const on = !!ts;
      return `<div class="task-row${on?' done':''}">
        <div class="chk${on?' on':''}" onclick="toggle(${i})">✓</div>
        <span class="tname">${t.n}</span>
        ${on ? `<span class="tmeta">${ago(ts)}</span>` : ''}
        <div class="tbadge ${BC[t.c]}">${t.c}</div>
      </div>`;
    }).join('');
}

/* ── RENDER: HISTORY ── */
function renderHistory() {
  const week = Date.now() - 7*24*3600*1000;
  const done = TASKS
    .map((t,i)=>({...t,i,ts:state[i]}))
    .filter(t=>t.ts)
    .sort((a,b)=>b.ts-a.ts);

  const recent = done.filter(t=>t.ts>=week);
  const older  = done.filter(t=>t.ts<week);

  const el = document.getElementById('history-list');

  if (!done.length) {
    el.innerHTML = `<p style="text-align:center;color:var(--tx-light);padding:2rem;font-style:italic;font-size:13px">No completed tasks yet — roll the die!</p>`;
    return;
  }

  const row = t => `<div class="task-row">
    <div class="chk on" onclick="toggle(${t.i})">✓</div>
    <span class="tname">${t.n}</span>
    <span class="tmeta">${ago(t.ts)}</span>
    <div class="tbadge ${BC[t.c]}">${t.c}</div>
  </div>`;

  let html = '';
  if (recent.length) {
    html += `<div class="sec-label">✓ Done this week (${recent.length})</div>`;
    html += recent.map(row).join('');
  }
  if (older.length) {
    if (recent.length) html += `<div class="sec-line"></div>`;
    html += `<div class="sec-label">⏳ Overdue / not done recently (${older.length})</div>`;
    html += older.map(row).join('');
  }
  el.innerHTML = html;
}

function renderPage() { renderStats(); renderAll(); renderHistory(); }

/* ── TOGGLE ── */
function toggle(i) {
  if (state[i]) delete state[i]; else state[i] = Date.now();
  save();
  renderPage();
  if (rollIdx === i) refreshDoneBtn();
}

/* ── TABS ── */
function showTab(name) {
  ['all','history'].forEach(n => {
    document.getElementById('tab-'+n).classList.toggle('active', n===name);
    document.getElementById('panel-'+n).classList.toggle('active', n===name);
  });
}

/* ── DICE ── */
function roll() {
  const btn = document.getElementById('roll-btn');
  const numEl = document.getElementById('die-num');
  btn.disabled = true;
  numEl.style.opacity = '0';

  let ticks = 0;
  const iv = setInterval(() => {
    numEl.textContent = Math.floor(Math.random()*10)+1;
    ticks++;
    if (ticks >= 13) {
      clearInterval(iv);
      const n = Math.floor(Math.random()*10)+1;
      numEl.textContent = n;
      numEl.style.opacity = '1';
      showResult(n);
      btn.disabled = false;
    }
  }, 58);
  setTimeout(() => { numEl.style.opacity = '1'; }, 200);
}

function showResult(n) {
  const cat  = DMAP[n];
  const pool = TASKS.map((t,i)=>({...t,i})).filter(t=>t.c===cat && !state[t.i]);
  const all  = TASKS.map((t,i)=>({...t,i})).filter(t=>t.c===cat);
  const pick = pool.length ? pool[Math.floor(Math.random()*pool.length)]
                           : all[Math.floor(Math.random()*all.length)];
  rollIdx = pick.i;

  document.getElementById('res-badge').className = 'badge '+BC[cat];
  document.getElementById('res-badge').textContent = cat;
  document.getElementById('res-name').textContent = pick.n;
  document.getElementById('res-sub').textContent  = `${FREQ[cat]} · Rolled a ${n}`;
  document.getElementById('result').classList.remove('hidden');
  refreshDoneBtn();
}

function markDone() {
  if (rollIdx === null) return;
  if (state[rollIdx]) delete state[rollIdx]; else state[rollIdx] = Date.now();
  save();
  renderPage();
  refreshDoneBtn();
}

function refreshDoneBtn() {
  const btn = document.getElementById('done-btn');
  const done = rollIdx !== null && !!state[rollIdx];
  btn.textContent = done ? '✓ Done!' : 'Mark done';
  btn.classList.toggle('marked', done);
}

/* ── RESET ── */
function resetAll() {
  if (!confirm('Reset all completed tasks?')) return;
  state = {};
  save();
  rollIdx = null;
  document.getElementById('result').classList.add('hidden');
  renderPage();
}

/* ── EXPORT ── */
function exportCSV() {
  const rows = ['Task,Category,Status,"Completed At"'];
  TASKS.forEach((t,i) => {
    const ts = state[i];
    rows.push(`"${t.n}",${t.c},${ts?'Done':'Pending'},"${ts?new Date(ts).toLocaleString():''}"`);
  });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([rows.join('\n')], {type:'text/csv'}));
  a.download = 'cleaning-'+new Date().toISOString().slice(0,10)+'.csv';
  a.click();
}

/* ── PWA INSTALL ── */
let pwaPrompt = null;
window.addEventListener('beforeinstallprompt', e => {
  e.preventDefault();
  pwaPrompt = e;
  if (!localStorage.getItem('hint-closed')) {
    document.getElementById('install-hint').classList.remove('hidden');
  }
});
function installPWA() {
  if (pwaPrompt) {
    pwaPrompt.prompt();
    pwaPrompt.userChoice.then(() => { pwaPrompt = null; closeHint(); });
  }
}
function closeHint() {
  document.getElementById('install-hint').classList.add('hidden');
  localStorage.setItem('hint-closed','1');
}

/* ── BOOT ── */
renderPage();
</script>
</body>
</html>
