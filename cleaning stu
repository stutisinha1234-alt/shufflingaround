<!-- MAIN APP -->
<div class="wrap">

  <div class="header">
    <h1>🏠 My Cleaning Tracker</h1>
    <p>Roll the die · tackle what comes up · keep it blooming</p>
  </div>

  <div class="stats" id="stats"></div>

  <!-- Dice section -->
  <div class="dice-box">
    <div class="die" id="die" onclick="roll()">
      <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <polygon points="50,4 96,26 96,74 50,96 4,74 4,26"
          fill="#FAE8DF" stroke="#E8825A" stroke-width="2.5"/>
        <polygon points="50,17 83,34 83,66 50,83 17,66 17,34"
          fill="none" stroke="#F2A987" stroke-width="1"/>
      </svg>
      <div class="die-num" id="die-num">?</div>
    </div>
    <button class="roll-btn" id="roll-btn" onclick="roll()">✦ Roll the die</button>
    <div class="result hidden" id="result">
      <div class="badge" id="res-badge"></div>
      <div class="result-info">
        <div class="result-name" id="res-name"></div>
        <div class="result-sub"  id="res-sub"></div>
      </div>
      <button class="done-btn" id="done-btn" onclick="markDone()">Mark done</button>
    </div>
  </div>

  <!-- Tabs -->
  <div class="tabs">
    <button class="tab active" id="tab-all"     onclick="showTab('all')">All tasks</button>
    <button class="tab"        id="tab-history" onclick="showTab('history')">✓ This week</button>
  </div>

  <div class="legend">
    <span><span class="ldot" style="background:#FDDDD0;border:1px solid #F5B09A"></span>A · daily</span>
    <span><span class="ldot" style="background:#F7D6DF;border:1px solid #F0ABBE"></span>B · weekly</span>
    <span><span class="ldot" style="background:#FFF0CC;border:1px solid #FFD97A"></span>C · monthly</span>
    <span><span class="ldot" style="background:#D8F0EB;border:1px solid #9ADACB"></span>D · whenever</span>
  </div>

  <div class="panel active" id="panel-all">
    <div class="task-list" id="task-list"></div>
  </div>

  <div class="panel" id="panel-history">
    <div id="history-list"></div>
  </div>

  <div class="footer">
    <button class="reset-btn" onclick="resetAll()">Reset all</button>
    <button class="export-btn" onclick="exportCSV()">⬇ Export CSV</button>
  </div>

</div>

<!-- Install hint -->
